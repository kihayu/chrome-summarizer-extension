{
  "name": "article-summarizer",
  "module": "index.ts",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "private": true,
  "scripts": {
    "build": "bun run bundler.ts",
    "dev": "bun run build --watch",
    "lint": "eslint . --ext .ts && prettier --check 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint . --ext .ts --fix && prettier --write 'src/**/*.{ts,tsx}'"
  },
  "type": "module"
}
